---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../components/BaseLayout.astro';

const photos = await getCollection('fotografia');
const sortedPhotos = photos.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) => {
  return date.toLocaleDateString('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
};

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Fotografia | Egidio Giacoia" description="Galleria e storie fotografiche curate da Egidio Giacoia. Ogni scatto ha una sua storia.">
  <h1>Fotografia</h1>
  <p class="section-intro">
    Una raccolta di scatti e progetti fotografici. Ogni immagine è accompagnata da metadati e da una breve riflessione sulla luce o sulla cattura.
  </p>

  {sortedPhotos.length === 0 ? (
    <p class="empty-state">Nessuno scatto presente nella galleria al momento.</p>
  ) : (
    <div class="photo-grid" id="photo-grid">
      {sortedPhotos.map((photo) => (
        <a href={`${baseUrl}fotografia/${photo.id}`} class="photo-card-link" id={`photo-link-${photo.id}`}>
          <article class="photo-card-item">
            <div class="photo-image-container">
              <Image 
                src={photo.data.cover} 
                alt={photo.data.title}
                widths={[320, 640]}
                sizes="(max-width: 600px) 100vw, 50vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="photo-card-details">
              <span class="photo-card-title">{photo.data.title}</span>
              <div class="photo-card-meta">
                {photo.data.location && <span class="photo-card-loc">{photo.data.location}</span>}
                <time datetime={photo.data.pubDate.toISOString()}>{formatDate(photo.data.pubDate)}</time>
              </div>
            </div>
          </article>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .section-intro {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    max-width: 60ch;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
    margin-top: 2rem;
  }

  /* Photo Grid Layout */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .photo-card-link {
    text-decoration: none;
    color: inherit;
  }

  .photo-card-item {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--card-bg);
    overflow: hidden;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .photo-card-item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .photo-image-container {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background-color: #000;
  }

  .photo-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-medium);
  }

  .photo-card-item:hover .photo-image-container img {
    transform: scale(1.02);
  }

  .photo-card-details {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .photo-card-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
  }

  .photo-card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .photo-card-loc {
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .photo-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
