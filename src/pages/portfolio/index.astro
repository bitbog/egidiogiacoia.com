---
import BaseLayout from '../../components/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Portfolio | Egidio Giacoia"
  description="Fotografo e content creator a Potenza, in Basilicata. Servizi fotografici per turismo e brand, eventi e ritratti."
>
  <!-- ===================== INTRO ===================== -->
  <section class="intro" id="top">
    <p class="eyebrow">Portfolio — Fotografia &amp; content creation</p>
    <h1>Immagini con un <em>obiettivo</em>.</h1>
    <p class="lede">
      Sono <strong>Egidio Giacoia</strong>, fotografo e content creator a Potenza, in Basilicata.
      Lavoro con destinazioni, brand e persone per trasformare un luogo, una serata o un volto
      in immagini che restano e che portano un risultato.
    </p>
  </section>

  <!-- ===================== PORTFOLIO NAVIGATION GRID ===================== -->
  <section class="portfolio-hub">
    <div class="portfolio-grid">
      <!-- Brand & Turismo -->
      <a href={`${baseUrl}portfolio/brand-turismo`} class="portfolio-card category-card brand-turismo-card">
        <div class="card-bg-overlay"></div>
        <span class="card-title">Brand &amp; Turismo</span>
      </a>

      <!-- Eventi -->
      <a href={`${baseUrl}portfolio/eventi`} class="portfolio-card category-card eventi-card">
        <div class="card-bg-overlay"></div>
        <span class="card-title">Eventi</span>
      </a>

      <!-- Ritratti -->
      <a href={`${baseUrl}portfolio/ritratti`} class="portfolio-card category-card ritratti-card">
        <div class="card-bg-overlay"></div>
        <span class="card-title">Ritratti</span>
      </a>

      <!-- Chi sono -->
      <a href={`${baseUrl}portfolio/chi-sono`} class="portfolio-card long-card chi-sono-card">
        <span class="long-card-title">Chi sono</span>
      </a>

      <!-- Contatti -->
      <a href={`${baseUrl}portfolio/contatti`} class="portfolio-card long-card contatti-card">
        <span class="long-card-title">Contatti</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- INTRO ---------- */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s4);
  }

  .lede {
    font-size: 1.18rem;
    color: var(--muted);
    max-width: 56ch;
    margin-bottom: var(--s5);
  }
  .lede strong { color: var(--text); font-weight: 500; }

  /* ---------- PORTFOLIO HUB GRID ---------- */
  .portfolio-hub {
    border-top: 1px solid var(--border);
    padding-top: var(--s7);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--s5);
    margin: var(--s2) 0 var(--s6);
  }

  /* Base properties for all portfolio cards */
  .portfolio-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    transition: border-color var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  /* --- Category Cards (With blurred background image) --- */
  .category-card {
    height: 185px;
    color: #ffffff;
    text-align: center;
    z-index: 1;
  }

  .category-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-color: var(--surface); /* Fallback color */
    z-index: -2;
    transition: transform var(--transition-medium);
  }

  /* 
    Background Images. 
    Per inserire le tue foto sfocate di sfondo:
    1. Salva i file in /public/img/portfolio/ usando i nomi qui sotto 
       (es. bg-brand-turismo.jpg, bg-eventi.jpg, bg-ritratti.jpg)
    2. In alternativa, puoi scommentare i percorsi fallback per usare le foto originali.
  */
  .brand-turismo-card::before {
    background-image: url('/img/portfolio/bg-brand-turismo.jpg');
    /* Per usare la foto originale come fallback temporaneo: */
    /* background-image: url('/img/portfolio/vista-panoramica-castelsaraceno.jpg'); */
  }

  .eventi-card::before {
    background-image: url('/img/portfolio/bg-eventi.jpg');
    /* Per usare la foto originale come fallback temporaneo: */
    /* background-image: url('/img/portfolio/festa-e-balli.jpg'); */
  }

  .ritratti-card::before {
    background-image: url('/img/portfolio/bg-ritratti.jpg');
    /* Per usare la foto originale come fallback temporaneo: */
    /* background-image: url('/img/portfolio/come-su-vogue.jpg'); */
  }

  .card-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.65));
    z-index: -1;
    transition: background-color var(--transition-fast);
  }

  .category-card:hover {
    border-color: var(--accent);
    box-shadow: 0 10px 25px -10px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .category-card:hover::before {
    transform: scale(1.06);
  }

  .category-card:hover .card-bg-overlay {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.75));
  }

  .category-card .card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
  }

  /* --- Long Cards (Chi sono / Contatti) --- */
  .long-card {
    height: 100px;
    background: var(--surface);
    color: var(--accent);
  }

  .long-card:hover {
    border-color: var(--accent);
    background-color: var(--accent-2);
  }

  .long-card-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  /* Desktop Grid placement */
  .brand-turismo-card { order: 1; }
  .eventi-card { order: 2; }
  .ritratti-card { order: 3; }
  
  .chi-sono-card {
    grid-column: span 3;
    order: 4;
  }
  
  .contatti-card {
    grid-column: span 3;
    order: 5;
  }

  /* ---------- RESPONSIVE / MOBILE ---------- */
  @media (max-width: 600px) {
    .portfolio-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s4);
    }

    /* Small pills for Chi sono and Contatti at the top */
    .chi-sono-card {
      grid-column: span 1;
      order: 1;
      height: 52px;
      border-radius: 999px;
    }

    .contatti-card {
      grid-column: span 1;
      order: 2;
      height: 52px;
      border-radius: 999px;
    }

    .chi-sono-card .long-card-title,
    .contatti-card .long-card-title {
      font-family: var(--font-sans);
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* Categories stack below the pills */
    .brand-turismo-card {
      grid-column: span 2;
      order: 3;
    }

    .eventi-card {
      grid-column: span 2;
      order: 4;
    }

    .ritratti-card {
      grid-column: span 2;
      order: 5;
    }
  }
</style>
