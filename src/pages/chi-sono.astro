---
import BaseLayout from '../components/BaseLayout.astro';
import { siteConfig } from '../data/site';

const fotoChiSono = '/img/portfolio/profilo.webp';
const baseUrl = import.meta.env.BASE_URL;

const pillars = [
  {
    num: '01 · Fotografia',
    title: 'Fotografia Commerciale, Eventi & Ritratti',
    desc: 'Scatti curati per B&B, hotel, brand, contenuti social, reportage dal vivo e sessioni ritrattistiche in Basilicata.'
  },
  {
    num: '02 · Web & SEO',
    title: 'Sviluppo Siti Web & SEO Locale',
    desc: 'Piattaforme veloci, leggere e mobile-first pensate per raccontare attività locali e portarle tra i risultati di ricerca.'
  },
  {
    num: '03 · Manifattura Additiva',
    title: 'Progettazione & Stampa 3D',
    desc: 'Modellazione CAD e oggetti reali su misura: portachiavi, targhette e supporti QR/NFC integrati con il sito web.'
  }
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.siteName,
  url: `${siteConfig.siteUrl}/chi-sono`,
  image: `${siteConfig.siteUrl}${fotoChiSono}`,
  jobTitle: 'Fotografo, Sviluppatore Web e Progettista 3D',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Potenza',
    addressRegion: 'Basilicata',
    addressCountry: 'IT'
  }
};
---

<BaseLayout
  title="Chi Sono | Informatica, Fotografia & Stampa 3D in Basilicata | Egidio Giacoia"
  description="Scopri chi è Egidio Giacoia: fotografo, sviluppatore web e progettista 3D a Potenza e in Basilicata. Unisco informatica, fotografia e manifattura additiva."
  keywords="Egidio Giacoia, fotografo Potenza, sviluppatore web Basilicata, stampa 3D Potenza, chi sono"
  schema={personSchema}
>
  <section id="chi-sono">
    <div class="kicker"><span class="num">—</span><span class="lab">Chi sono</span></div>

    <div class="bio reveal-on-scroll">
      <figure class="bio-photo">
        <img
          src={fotoChiSono}
          alt="Egidio Giacoia — Fotografo, sviluppatore web e progettista 3D in Basilicata"
          width="427"
          height="640"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="bio-text">
        <h1>Egidio Giacoia</h1>
        <p>
          Fotografo, sviluppatore web e progettista 3D con un'anima da informatico. L'informatica mi ha insegnato a
          progettare strutture solide, veloci e orientate a risolvere problemi reali; la fotografia a cogliere
          l'attimo, l'emozione e la luce giusta; la progettazione CAD e la stampa 3D a trasformare un'idea digitale in un oggetto concreto.
        </p>
        <p>
          Lavoro a Potenza e in tutta la Basilicata accanto a brand, strutture ricettive, B&amp;B, destinazioni turistiche e persone.
          Unire queste competenze mi permette di offrire un percorso completo sotto un unico tetto: dallo shooting fotografico
          per sito e canali social fino allo sviluppo web, al posizionamento SEO locale e alla realizzazione di oggetti su misura in stampa 3D.
        </p>
        <p>
          Quando non ho la macchina fotografica in mano, il codice aperto o la stampante al lavoro, mi trovi su un sentiero di montagna
          tra i boschi lucani o immerso in un buon libro: credo che la curiosità sia il motore di tutto.
        </p>

        <div class="bio-actions">
          <a href={`${baseUrl}portfolio`} class="bio-btn-primary">Esplora il portfolio &rarr;</a>
          <a href={`${baseUrl}contatti`} class="bio-btn-secondary">Contattami</a>
        </div>
      </div>
    </div>

    <div class="bio-pillars reveal-on-scroll" aria-label="Ambiti di lavoro">
      {pillars.map((p) => (
        <article class="bio-pillar-card">
          <span class="bio-pillar-num">{p.num}</span>
          <h2>{p.title}</h2>
          <p>{p.desc}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  section {
    border-top: none;
    padding-top: 0;
  }

  .bio {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--s7);
    align-items: start;
    margin-top: var(--s4);
  }

  .bio-photo {
    margin: 0;
  }

  .bio-photo img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
    display: block;
    box-shadow: 0 14px 36px -20px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .bio-text h1 {
    margin-top: 0;
    margin-bottom: var(--s4);
    font-size: clamp(30px, 5vw, 42px);
  }

  .bio-text p {
    font-size: 1.06rem;
    line-height: 1.72;
    color: var(--text-muted);
    margin-bottom: var(--s4);
    max-width: 62ch;
  }

  .bio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--s5);
  }

  .bio-btn-primary,
  .bio-btn-secondary {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    padding: 11px 18px;
    border-radius: 10px;
    transition: opacity var(--transition-fast), transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .bio-btn-primary {
    background: var(--accent);
    color: var(--paper);
  }

  .bio-btn-primary:hover {
    opacity: 0.92;
    transform: translateY(-1.5px);
    color: var(--paper);
  }

  .bio-btn-secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .bio-btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-2);
  }

  .bio-pillars {
    margin-top: var(--s8);
    padding-top: var(--s7);
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s4);
  }

  .bio-pillar-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: 20px 22px;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .bio-pillar-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .bio-pillar-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .bio-pillar-card h2 {
    font-family: var(--font-serif);
    font-size: 1.18rem;
    margin: 0 0 8px;
    line-height: 1.25;
  }

  .bio-pillar-card p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .bio {
      grid-template-columns: 1fr;
      gap: var(--s5);
    }

    .bio-photo {
      max-width: 280px;
    }

    .bio-pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
