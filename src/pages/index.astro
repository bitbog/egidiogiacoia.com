---
// Importa le funzioni necessarie da Astro per caricare le collezioni e gli elementi singoli
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';

// Recupera le collezioni dei contenuti
const diaryEntries = await getCollection('diario');
const portfolioEntries = await getCollection('portfolio');

// Ordina gli elementi del Diario per data decrescente (pubDate) per trovare l'ultimo pubblicato
const latestDiary = diaryEntries
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())[0];

// Ordina gli elementi del Portfolio per data decrescente per trovare l'ultimo caricato
const latestPortfolio = portfolioEntries
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())[0];

const baseUrl = import.meta.env.BASE_URL;

// Costruisce i link dinamici per puntare all'ultimo articolo caricato (o alla pagina indice di fallback)
const diaryLink = latestDiary ? `${baseUrl}diario/${latestDiary.id}` : `${baseUrl}diario`;
const portfolioLink = latestPortfolio ? `${baseUrl}portfolio/${latestPortfolio.id}` : `${baseUrl}portfolio`;
const nowLink = `${baseUrl}now`;

// Recupera la pagina "now" per estrarre la data dell'ultimo aggiornamento generale
const nowEntry = await getEntry('now', 'index');
const nowLastUpdated = nowEntry?.data.lastUpdated;

// Helper per formattare la data nel formato leggibile italiano (es. "16 giugno 2026")
const formatDate = (date: Date) => {
  return date.toLocaleDateString('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
};
---

<BaseLayout title="Egidio Giacoia | Home" description="Sito personale, blog e portfolio di Egidio Giacoia. Fotografo e creativo.">
  <section class="intro-section">
    <h1>Ciao, questo è il mio spazio personale.</h1>
    
    <div class="prose">
      <p>
          Mi chiamo Egidio, sono uno studente di Informatica. Dall'inizio del 2026 ho tolto tutti i
          social dalla mia vita e nel mese di maggio 2026 ho deciso di creare questo sito per avere
          uno spazio su internet in cui scrivo quello che voglio liberamente e senza i limiti che impongono
          le piattaforme social. Inoltre, curo un portfolio di immagini.
      </p>
      <p>
        Puoi leggere l'ultimo articolo usando i link qui sotto o per un indice generale, usare il menù:
      </p>
    </div>

    <!-- Griglia di Navigazione Principale -->
    <div class="navigation-grid">
      <!-- Scheda Diario: Dispone di un alone morbido retroilluminato per la profondità -->
      <a href={diaryLink} class="nav-card diario-card">
        <div class="card-header">
          <span class="section-title">Diario</span>
        </div>
        <div class="card-body">
          {latestDiary ? (
            <span class="latest-title">{latestDiary.data.title}</span>
          ) : (
            <p class="card-desc">Pensieri liberi, note e riflessioni senza una scadenza o una categoria precisa.</p>
          )}
        </div>
        <div class="card-footer">
          <span class="card-meta">
            {latestDiary ? formatDate(latestDiary.data.pubDate) : "Esplora la sezione"}
          </span>
          <span class="card-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </div>
      </a>
      
      <!-- Scheda Now: Dispone dell'effetto Alone Radiale che segue il puntatore del mouse -->
      <a href={nowLink} class="nav-card now-card" id="nowCard">
        <div class="card-header">
          <span class="section-title">Now</span>
        </div>
        <div class="card-body">
          <p class="card-desc">Cosa sto facendo esattamente in questo periodo della mia vita.</p>
        </div>
        <div class="card-footer">
          <span class="card-meta">
            {nowLastUpdated ? formatDate(nowLastUpdated) : "Scopri cosa faccio ora"}
          </span>
          <span class="card-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </div>
      </a>
      
      <!-- Scheda Portfolio: Scritta singola centrata su tutta la riga (span 2) -->
      <a href={`${baseUrl}portfolio`} class="nav-card portfolio-card-span portfolio-card-centered">
        <span class="portfolio-centered-title">Portfolio</span>
      </a>
    </div>

    <!-- Sezione Contatti in fondo -->
    <div class="contacts-section">
      <h2>Contatti</h2>
      <p>Se vuoi scrivermi o restare aggiornato su quello che scrivo, mi trovi qui:</p>
      <ul class="contacts-list">
        <li>Resta aggiornato: <a href="https://whatsapp.com/channel/0029VaFJXAvJ93wY6tcBGr2w">Canale WhatsApp</a></li>
        <li>Scrivimi: <a href="mailto:scrivimiegidio@gmail.com?subject=Messaggio%20dal%20sito">E-mail</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .intro-section {
    padding: var(--s2) 0;
  }

  h1 {
    font-size: clamp(32px, 6vw, 48px);
    margin-bottom: var(--s5);
  }

  /* Imposta Diario e Now affiancati (50% ciascuno) */
  .navigation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s5);
    margin: var(--s7) 0;
  }

  /* Proprietà generali delle schede */
  .nav-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 185px;
    min-width: 0;
    text-decoration: none;
    color: var(--text);
    padding: var(--s5);
    border-radius: 12px;
    background: var(--surface);
    position: relative;
  }

  /* Diario Card: Alone Posteriore Morbido per Creare Profondità */
  .diario-card {
    border: 1px solid var(--border);
    box-shadow: 
      0 10px 35px -10px color-mix(in srgb, var(--accent) 22%, transparent), 
      0 0 20px -5px color-mix(in srgb, var(--accent) 10%, transparent);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  .diario-card:hover {
    border-color: var(--accent);
    box-shadow: 
      0 15px 45px -8px color-mix(in srgb, var(--accent) 32%, transparent), 
      0 0 25px -2px color-mix(in srgb, var(--accent) 16%, transparent);
    background-color: var(--accent-2);
  }

  /* Now Card: Alone Radiale che Segue il Mouse */
  .now-card {
    border: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    background-color: var(--surface);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .now-card:hover {
    border-color: var(--accent);
    background-color: var(--accent-2);
  }

  /* Maschera di gradiente radiale controllata da JS via --mouse-x e --mouse-y */
  .now-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      200px circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
      color-mix(in srgb, var(--accent) 18%, transparent) 0%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }

  .now-card:hover::before {
    opacity: 1;
  }

  /* Mantiene il testo sopra il livello dell'alone luminoso */
  .now-card > * {
    position: relative;
    z-index: 2;
  }

  /* Portfolio Card: Estesa su 2 colonne e centrata */
  .portfolio-card-span {
    grid-column: span 2;
  }

  .portfolio-card-centered {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 120px;
    text-align: center;
    border: 1px solid var(--border);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .portfolio-card-centered:hover {
    border-color: var(--accent);
    background-color: var(--accent-2);
  }

  .portfolio-centered-title {
    font-family: var(--font-serif);
    font-size: clamp(26px, 5vw, 36px);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.015em;
    font-variation-settings: "opsz" 60;
  }

  .card-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
  }

  .section-title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    margin-top: var(--s2);
    margin-bottom: var(--s2);
    min-width: 0;
  }

  .latest-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }

  .card-desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding-top: var(--s3);
  }

  .card-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  .card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: transform var(--transition-medium), color var(--transition-fast);
  }

  .nav-card:hover .card-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  .contacts-section {
    margin-top: var(--s9);
    border-top: 1px solid var(--border);
    padding-top: var(--s7);
  }

  .contacts-section h2 {
    font-size: 1.6rem;
    margin-bottom: var(--s4);
  }

  .contacts-list {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    margin-top: var(--s4);
  }

  .contacts-list li {
    font-size: 0.95rem;
  }

  /* Layout per dispositivi Mobile (Impila le schede verticalmente) */
  @media (max-width: 600px) {
    .navigation-grid {
      grid-template-columns: 1fr;
      gap: var(--s4);
    }
    .portfolio-card-span {
      grid-column: span 1;
    }
  }
</style>

<!-- Script Client-Side per la gestione dell'Alone Interattivo su Now -->
<script>
  function setupMouseGlow() {
    const card = document.querySelector('.now-card') as HTMLElement;
    if (!card) return;

    // Aggiorna le variabili CSS con la posizione del cursore relativa alla scheda
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    });
  }

  // Esegue l'inizializzazione sia all'avvio che dopo cambi di pagina fluidi
  setupMouseGlow();
  document.addEventListener('astro:after-swap', setupMouseGlow);
</script>
