---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';

const projects = await getCollection('progetti');

// Sort projects by date descending
const sortedProjects = projects.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Filter projects by status
const projectsInProgress = sortedProjects.filter(p => p.data.status === 'in corso');
const projectsCompleted = sortedProjects.filter(p => p.data.status === 'completato');

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Progetti | Egidio Giacoia" description="Portfolio dei progetti ed esperimenti realizzati da Egidio Giacoia, suddivisi per stato di avanzamento.">
  <h1>Progetti</h1>
  <p class="section-intro">
    Una raccolta di cose costruite o in fase di costruzione: software, prototipi fisici, design ed esperimenti. Ogni progetto è descritto nei dettagli con il proprio stato di avanzamento.
  </p>

  <!-- Projects In Progress Section -->
  <section class="projects-section">
    <h2>In Corso</h2>
    {projectsInProgress.length === 0 ? (
      <p class="empty-state">Al momento non ci sono progetti in corso di sviluppo.</p>
    ) : (
      <div class="projects-grid" id="projects-in-progress">
        {projectsInProgress.map((project) => (
          project.data.link ? (
            <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="project-card-link">
              <article class="project-card">
                <div class="project-header">
                  <h3 class="project-title">{project.data.title}</h3>
                  <span class="project-status in-corso">{project.data.status}</span>
                </div>
                <p class="project-description">{project.data.description}</p>
              </article>
            </a>
          ) : (
            <a href={`${baseUrl}progetti/${project.id}`} class="project-card-link">
              <article class="project-card">
                <div class="project-header">
                  <h3 class="project-title">{project.data.title}</h3>
                  <span class="project-status in-corso">{project.data.status}</span>
                </div>
                <p class="project-description">{project.data.description}</p>
              </article>
            </a>
          )
        ))}
      </div>
    )}
  </section>

  <!-- Projects Completed Section -->
  <section class="projects-section mt-4">
    <h2>Completati</h2>
    {projectsCompleted.length === 0 ? (
      <p class="empty-state">Al momento non ci sono progetti completati.</p>
    ) : (
      <div class="projects-grid" id="projects-completed">
        {projectsCompleted.map((project) => (
          project.data.link ? (
            <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="project-card-link">
              <article class="project-card">
                <div class="project-header">
                  <h3 class="project-title">{project.data.title}</h3>
                  <span class="project-status completato">{project.data.status}</span>
                </div>
                <p class="project-description">{project.data.description}</p>
              </article>
            </a>
          ) : (
            <a href={`${baseUrl}progetti/${project.id}`} class="project-card-link">
              <article class="project-card">
                <div class="project-header">
                  <h3 class="project-title">{project.data.title}</h3>
                  <span class="project-status completato">{project.data.status}</span>
                </div>
                <p class="project-description">{project.data.description}</p>
              </article>
            </a>
          )
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .section-intro {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    max-width: 60ch;
  }

  .projects-section {
    margin-bottom: 3.5rem;
  }

  .projects-section h2 {
    font-size: 1.4rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }
</style>
