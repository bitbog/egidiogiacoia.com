---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('progetti');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={`${project.data.title} | Progetti`} description={project.data.description}>
  <article class="project-container">
    <div class="project-header">
      <a href={`${baseUrl}progetti`} class="back-link">← Torna ai progetti</a>
      <div class="project-title-area">
        <h1>{project.data.title}</h1>
        <span class={`project-status ${project.data.status === 'in corso' ? 'in-corso' : 'completato'}`}>
          {project.data.status}
        </span>
      </div>
      {project.data.link && (
        <div class="external-link-container">
          <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="external-link-btn">
            Visita il sito o repository →
          </a>
        </div>
      )}
    </div>
    
    <div class="prose" id="project-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-container {
    padding: 1rem 0;
  }

  .project-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .project-title-area {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2.4rem;
    line-height: 1.25;
    margin: 0;
  }

  .project-status {
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-status.in-corso {
    background-color: var(--badge-in-progress-bg);
    color: var(--badge-in-progress-text);
  }

  .project-status.completato {
    background-color: var(--badge-completed-bg);
    color: var(--badge-completed-text);
  }

  .external-link-container {
    margin-top: 1.5rem;
  }

  .external-link-btn {
    display: inline-block;
    background-color: var(--accent);
    color: var(--bg);
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: opacity var(--transition-fast);
  }

  .external-link-btn:hover {
    opacity: 0.9;
  }
</style>
