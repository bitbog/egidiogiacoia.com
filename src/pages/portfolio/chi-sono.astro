---
import BaseLayout from '../../components/BaseLayout.astro';

// CHI SONO — il tuo ritratto (lascia '' per il riquadro vuoto)
const fotoChiSono = '/img/portfolio/profilo.jpg'; // es. '/img/portfolio/egidio.jpg'
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Chi Sono | Portfolio | Egidio Giacoia"
  description="Scopri chi è Egidio Giacoia: fotografo e content creator a Potenza, in Basilicata, con un'anima da informatico."
>
  <a href={`${baseUrl}portfolio`} class="back-link">&larr; Torna al portfolio</a>

  <!-- ===================== CHI SONO ===================== -->
  <section id="chi-sono">
    <div class="kicker"><span class="num">—</span><span class="lab">Chi sono</span></div>
    <div class="bio">
      <figure class="bio-photo">
        {fotoChiSono
          ? <img src={fotoChiSono} alt="Egidio Giacoia" loading="lazy" decoding="async" />
          : <div class="frame frame-portrait"><span>ritratto</span></div>}
      </figure>
      <div class="bio-text">
        <h1>Egidio Giacoia</h1>
        <p>
          Fotografo e content creator con un'anima da informatico. L'informatica mi ha insegnato a
          vedere le strutture e a risolvere problemi; la fotografia a cogliere l'attimo, l'emozione e la luce.
        </p>
        <p>
          Lavoro in Basilicata, tra brand, destinazioni e persone, cercando la precisione tecnica
          al servizio della bellezza più spontanea. Quando non ho la macchina in mano, mi trovi
          su un sentiero di montagna o dentro un libro di tecnologia: credo che la curiosità sia il motore di tutto.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    margin-bottom: var(--s5);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .back-link:hover {
    color: var(--accent);
  }

  section {
    border-top: none;
    padding-top: 0;
  }

  /* ---------- CHI SONO ---------- */
  .bio {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--s6);
    align-items: start;
    margin-top: var(--s4);
  }
  .bio-photo { margin: 0; }
  .frame-portrait { aspect-ratio: 4 / 5; }
  .bio-photo img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--border);
    display: block;
  }
  .bio-text h1 { margin-top: 0; font-size: clamp(28px, 5vw, 38px); }
  .bio-text p {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: var(--s4);
  }

  @media (max-width: 650px) {
    .bio { grid-template-columns: 1fr; gap: var(--s4); }
    .bio-photo { max-width: 280px; }
  }
</style>
