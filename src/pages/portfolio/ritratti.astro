---
import BaseLayout from '../../components/BaseLayout.astro';
import PortfolioSubnav from '../../components/PortfolioSubnav.astro';
import { getInstagramUrl } from '../../data/site';

// 03 · FOTOGRAFIA RITRATTISTICA (formato verticale, didascalie libere)
const ritratti = [
  { cap: 'Luce e movimento al tramonto', alt: 'Ritratto fotografico outdoor con danza al tramonto tra le montagne della Basilicata — Egidio Giacoia', src: '/img/portfolio/ritratto-danza-tramonto-montagna.webp', w: 900, h: 1350 },
  { cap: 'Equilibrio tra le vette', alt: 'Ritratto artistico all’aperto al tramonto con la montagna lucana sullo sfondo, Basilicata', src: '/img/portfolio/ritratto-danza-monte-basilicata.webp', w: 1200, h: 800 },
  { cap: 'Verso la luce', alt: 'Fotografia ritrattistica outdoor al tramonto con luce naturale e movimento in Basilicata', src: '/img/portfolio/ritratto-respiro-montagna.webp', w: 900, h: 1350 },
  { cap: 'Come su Vogue', alt: 'Come su Vogue — Fotografia ritrattistica editoriale a Potenza, Basilicata', src: '/img/portfolio/come-su-vogue.webp', w: 600, h: 900 },
  { cap: 'La scalata', alt: 'La scalata — Ritratto fotografico all’aperto in Basilicata', src: '/img/portfolio/la-scalata.webp', w: 600, h: 800 },
  { cap: 'Danza e passione', alt: 'Danza e passione — Ritratto artistico in movimento', src: '/img/portfolio/danza-e-passione.webp', w: 600, h: 900 },
  { cap: 'La montagna è vita', alt: 'La montagna è vita — Ritratto outdoor tra le montagne della Basilicata', src: '/img/portfolio/la-montagna-è-vita.webp', w: 600, h: 400 },
  { cap: 'Sono il King', alt: 'Sono il King — Ritratto spontaneo e caratteriale', src: '/img/portfolio/sono-il-king.webp', w: 600, h: 750 },
  { cap: 'In studio', alt: 'In studio — Ritratto fotografico professionale in studio a Potenza', src: '/img/portfolio/in-studio.webp', w: 600, h: 900 },
];

const baseUrl = import.meta.env.BASE_URL;
const instagramUrl = getInstagramUrl();
const contactHref = instagramUrl || `${baseUrl}contatti`;

const ritrattiSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Fotografia Ritrattistica a Potenza e in Basilicata',
  provider: {
    '@type': 'Person',
    name: 'Egidio Giacoia',
    url: 'https://egidiogiacoia.com'
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Basilicata'
  },
  serviceType: ['Ritratti Professionali', 'Ritratti in Studio', 'Ritratti Outdoor e Storytelling'],
  description:
    'Servizi fotografici di ritratto professionale, creativo e personale in studio o in esterna a Potenza e in tutta la Basilicata.'
};
---

<BaseLayout
  title="Fotografia Ritrattistica a Potenza e in Basilicata | Studio ed Esterni | Egidio Giacoia"
  description="Servizi di fotografia ritrattistica a Potenza e in Basilicata: ritratti professionali, editoriali e personali in studio o all'aperto."
  keywords="fotografo ritratti Potenza, fotografia ritrattistica Basilicata, book fotografico Potenza, ritratti professionali Basilicata"
  schema={ritrattiSchema}
>
  <PortfolioSubnav active="ritratti" />

  <!-- ===================== 04 · FOTOGRAFIA RITRATTISTICA ===================== -->
  <section id="ritratti">
    <div class="kicker"><span class="num">04</span><span class="lab">Fotografia Ritrattistica</span></div>
    <h1>Un ritratto che parli davvero di chi sei.</h1>
    <p class="section-intro-text">
      Ritratti professionali e personali a Potenza e in Basilicata: un'immagine che non si limita a posare,
      ma racconta carattere, storia e luce. Per un profilo professionale che funzioni davvero, o per un ritratto da tenere.
    </p>
    <div class="gallery g-3 g-portrait reveal-on-scroll">
      {ritratti.map((s) => (
        <figure class="shot">
          {s.src
            ? <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
            : <div class="frame"><span>foto</span></div>}
          {s.cap && <figcaption>{s.cap}</figcaption>}
        </figure>
      ))}
    </div>

    <div class="reveal-on-scroll">
      <h3 class="sub">Come funziona una sessione di ritratto</h3>
      <ul class="howto">
        <li><div><strong>Scelta di luce e location.</strong><span>Decidiamo insieme se scattare in studio o in esterna in Basilicata in base all'atmosfera che vuoi trasmettere.</span></div></li>
        <li><div><strong>Guida naturale davanti all'obiettivo.</strong><span>Nessuna posa forzata: ti accompagno passo dopo passo per farti sentire a tuo agio e ottenere espressioni autentiche.</span></div></li>
        <li><div><strong>Selezione curata e post-produzione.</strong><span>Ricevi gli scatti migliori lavorati con attenzione al colore e alla luce naturale, pronti per web e stampa.</span></div></li>
      </ul>
    </div>

    <p class="area-cta reveal-on-scroll">
      Vuoi prenotare una sessione di ritratto a Potenza o in Basilicata?{' '}
      <a
        href={contactHref}
        target={instagramUrl ? '_blank' : undefined}
        rel={instagramUrl ? 'noopener noreferrer' : undefined}
      >
        {instagramUrl ? 'Scrivimi su Instagram ↗' : 'Scrivimi per fissare una data'}
      </a>.
    </p>
  </section>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    margin-bottom: var(--s5);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .back-link:hover {
    color: var(--accent);
  }

  .section-intro-text {
    font-size: 1.12rem;
    color: var(--muted);
    max-width: 62ch;
    margin-bottom: var(--s6);
  }

  section {
    border-top: none;
    padding-top: 0;
  }

  /* ---------- SUB HEADINGS ---------- */
  .sub {
    margin-top: var(--s7);
    margin-bottom: var(--s2);
  }

  /* ---------- GALLERY (masonry, allineata al contenitore Studio 1180px) ---------- */
  .gallery {
    width: 100%;
    column-count: 3;
    column-gap: 14px;
    margin-top: var(--s4);
    margin-bottom: var(--s4);
  }
  @media (max-width: 900px) { .gallery { column-count: 2; } }

  @media (max-width: 768px) {
    .gallery {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      column-count: auto;
      column-gap: normal;
      width: auto;
      margin-left: -22px;
      margin-right: -22px;
      transform: none;
      padding: 4px 22px 16px 22px;
      scrollbar-width: none;
      -ms-overflow-style: none;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
    }
    .gallery::-webkit-scrollbar {
      display: none;
    }
    .gallery .shot {
      flex: 0 0 280px;
      max-width: 80vw;
      scroll-snap-align: start;
      margin: 0;
    }
    .gallery .shot img,
    .gallery .shot .frame {
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08), 0 1px 4px rgba(0, 0, 0, 0.04);
    }
  }

  .shot {
    margin: 0 0 12px;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
  }

  .shot img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .frame {
    aspect-ratio: var(--ar, 3 / 2);
    width: 100%;
    border-radius: 8px;
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--accent-2), color-mix(in srgb, var(--accent) 16%, var(--surface)));
  }
  .frame span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .g-portrait { --ar: 3 / 4; }

  figcaption {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 8px;
    line-height: 1.4;
  }

  /* ---------- COME FUNZIONA ---------- */
  .howto {
    list-style: none;
    margin: var(--s4) 0 0;
    padding: 0;
  }
  .howto li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 14px;
    padding: 13px 0;
    border-top: 1px solid var(--border);
  }
  .howto li:first-child { border-top: none; }
  .howto li::before {
    content: "";
    width: 7px;
    height: 7px;
    margin-top: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .howto strong { font-weight: 600; }
  .howto span { display: block; color: var(--muted); font-size: 0.95rem; margin-top: 2px; }

  /* ---------- AREA CTA ---------- */
  .area-cta {
    margin-top: var(--s6);
    font-size: 1.02rem;
    color: var(--text);
  }
  .area-cta a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    transition: border-color var(--transition-fast);
  }
  .area-cta a:hover { border-color: var(--accent); }
</style>
