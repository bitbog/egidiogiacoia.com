---
import '../styles/global.css';
import {
  siteConfig,
  getWhatsAppChatUrl,
  getInstagramUrl
} from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Immagine per le anteprime social (percorso relativo alla root del sito) */
  ogImage?: string;
  /** Parole chiave SEO opzionali */
  keywords?: string;
  /** Dati strutturati JSON-LD Schema.org */
  schema?: Record<string, any> | Record<string, any>[];
  /** Impedisce l'indicizzazione su motori di ricerca quando true */
  noindex?: boolean;
}

const {
  title = 'Egidio Giacoia',
  description = 'Egidio Giacoia: fotografia, sviluppo web, progettazione e stampa 3D in Basilicata. Portfolio, blog e pagina now.',
  ogImage = '/img/portfolio/profilo.webp',
  keywords,
  schema,
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const cleanPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

const isActive = (path: string) => {
  const target = `${baseUrl}${path}`.replace(/\/+/g, '/');
  const targetWithSlash = target.endsWith('/') ? target : `${target}/`;

  if (path === '' || path === '/') {
    return cleanPath === targetWithSlash;
  }
  return cleanPath.startsWith(targetWithSlash);
};

const isHome = isActive('/') || isActive('');
const whatsappChatUrl = getWhatsAppChatUrl();
const instagramUrl = getInstagramUrl();
---

<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="geo.region" content="IT-PZ" />
    <meta name="geo.placename" content="Potenza, Basilicata" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- SEO & Favicon -->
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F2F2EF" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15161B" />

    <!-- Open Graph / Anteprime social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta name="twitter:card" content="summary" />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    )}

    <!-- Font di Google: preconnect + link -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=DM+Mono:wght@400;500&display=swap" />

    <!-- Script Tema Automatico -->
    <script is:inline>
      window.applyTheme = function() {
        const storedTheme = localStorage.getItem('theme');
        let isDark = false;

        if (storedTheme) {
          isDark = storedTheme === 'dark';
        } else {
          isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        }

        document.documentElement.classList.toggle('dark', isDark);
      };

      window.applyTheme();

      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          document.documentElement.classList.toggle('dark', e.matches);
        }
      });
    </script>
  </head>
  <body>
    <!-- Header Unico Fisso -->
    <header class="bar">
      <div class="bar-in">
        <div class="brand-group">
          <a href={baseUrl} class="brand">{siteConfig.siteName}</a>
        </div>

        <!-- Menu Desktop Unico -->
        <nav class="links" aria-label="Navigazione principale">
          <a href={`${baseUrl}portfolio`} class={isActive('portfolio') ? 'active' : ''}>Portfolio</a>
          <a href={`${baseUrl}blog`} class={isActive('blog') ? 'active' : ''}>Blog</a>
          <a href={`${baseUrl}now`} class={isActive('now') ? 'active' : ''}>Now</a>
          <a href={`${baseUrl}chi-sono`} class={isActive('chi-sono') ? 'active' : ''}>Chi sono</a>
          <a href={`${baseUrl}contatti`} class={`nav-cta-pill ${isActive('contatti') ? 'active' : ''}`}>Contatti &rarr;</a>
        </nav>

        <!-- Pulsante Cambio Tema -->
        <button id="theme-toggle" class="theme-toggle-btn" aria-label="Cambia tema scuro/chiaro">
          <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Pulsante Menu Mobile -->
    <button id="mobile-menu-toggle" class="mobile-menu-toggle-btn" aria-label="Menu navigazione">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <!-- Overlay Menu Mobile Unico -->
    <div id="mobile-menu-overlay" class="mobile-menu-overlay">
      <nav class="mobile-nav" aria-label="Menu mobile">
        <a href={baseUrl} class={isHome ? 'active' : ''}>Home</a>
        <a href={`${baseUrl}portfolio`} class={isActive('portfolio') ? 'active' : ''}>Portfolio</a>
        <a href={`${baseUrl}blog`} class={isActive('blog') ? 'active' : ''}>Blog</a>
        <a href={`${baseUrl}now`} class={isActive('now') ? 'active' : ''}>Now</a>
        <a href={`${baseUrl}chi-sono`} class={isActive('chi-sono') ? 'active' : ''}>Chi sono</a>
        <a href={`${baseUrl}contatti`} class={`mobile-cta-link ${isActive('contatti') ? 'active' : ''}`}>Contatti &rarr;</a>
      </nav>
    </div>

    <!-- Contenitore Principale -->
    <main class="wrap">
      <div class="container">
        <slot />
      </div>

      <!-- Footer Unificato -->
      <footer>
        <div class="footer-contacts">
          <p>
            <a href={`${baseUrl}contatti`}>Contatti</a>
            {whatsappChatUrl && (
              <>
                &nbsp;·&nbsp;
                <a href={whatsappChatUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
              </>
            )}
            {instagramUrl && (
              <>
                &nbsp;·&nbsp;
                <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
              </>
            )}
            &nbsp;·&nbsp;
            <a href={siteConfig.whatsappChannelUrl} target="_blank" rel="noopener noreferrer">Canale WhatsApp</a>
          </p>
        </div>
        <p>© 2026 {siteConfig.siteName} · {siteConfig.location}</p>
      </footer>
    </main>

    <!-- Lightbox Fotografico Globale -->
    <div
      id="portfolio-lightbox"
      class="lightbox-overlay"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-label="Anteprima immagine"
    >
      <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Chiudi anteprima">&times;</button>
      <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Immagine precedente">&#8592;</button>
      <div class="lightbox-content">
        <img id="lightbox-img" src="" alt="" />
        <p id="lightbox-caption" class="lightbox-caption"></p>
      </div>
      <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Immagine successiva">&#8594;</button>
    </div>

    <!-- Script Menu Mobile, Theme Toggle, Scroll Reveal e Lightbox -->
    <script>
      function closeMenu() {
        document.getElementById('mobile-menu-toggle')?.classList.remove('open');
        document.getElementById('mobile-menu-overlay')?.classList.remove('open');
        document.body.classList.remove('menu-open');
      }

      /* ---------- SCROLL REVEAL GLOBALE ---------- */
      let revealObserver: IntersectionObserver | null = null;

      function initScrollReveal() {
        const revealEls = Array.from(document.querySelectorAll<HTMLElement>('.reveal-on-scroll'));
        if (revealEls.length === 0) return;

        if (revealObserver) {
          revealObserver.disconnect();
          revealObserver = null;
        }

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver?.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
        );

        revealEls.forEach((el) => {
          if (!el.classList.contains('is-visible')) {
            revealObserver?.observe(el);
          }
        });
      }

      /* ---------- LIGHTBOX FOTOGRAFICO GLOBALE ---------- */
      let lightboxImages: HTMLImageElement[] = [];
      let lightboxIndex = -1;
      let touchStartX = 0;

      function getLightboxEls() {
        return {
          overlay: document.getElementById('portfolio-lightbox'),
          img: document.getElementById('lightbox-img') as HTMLImageElement | null,
          caption: document.getElementById('lightbox-caption'),
          prev: document.getElementById('lightbox-prev') as HTMLButtonElement | null,
          next: document.getElementById('lightbox-next') as HTMLButtonElement | null,
        };
      }

      function renderLightboxImage(index: number) {
        const { img, caption, prev, next } = getLightboxEls();
        if (!img || !caption || lightboxImages.length === 0) return;

        lightboxIndex = (index + lightboxImages.length) % lightboxImages.length;
        const targetImg = lightboxImages[lightboxIndex];
        img.src = targetImg.currentSrc || targetImg.src;
        img.alt = targetImg.alt || '';

        const figure = targetImg.closest('figure');
        const figcap = figure?.querySelector('figcaption')?.textContent?.trim();
        const text = figcap || targetImg.alt || '';
        caption.textContent = lightboxImages.length > 1 && text
          ? `${text} · ${lightboxIndex + 1}/${lightboxImages.length}`
          : text;

        const hasMultiple = lightboxImages.length > 1;
        if (prev) prev.hidden = !hasMultiple;
        if (next) next.hidden = !hasMultiple;
      }

      function openLightbox(clickedImg: HTMLImageElement) {
        const { overlay } = getLightboxEls();
        if (!overlay) return;

        lightboxImages = Array.from(document.querySelectorAll<HTMLImageElement>('.gallery .shot img'))
          .filter((el) => el.offsetParent !== null);

        const idx = lightboxImages.indexOf(clickedImg);
        if (idx === -1) return;

        renderLightboxImage(idx);
        overlay.classList.add('open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.classList.add('lightbox-open');
      }

      function closeLightbox() {
        const { overlay, img } = getLightboxEls();
        if (!overlay || !overlay.classList.contains('open')) return;
        overlay.classList.remove('open');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('lightbox-open');
        if (img) img.src = '';
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        // Lightbox: apertura su clic immagine in galleria
        const galleryImg = target.closest('.gallery .shot img') as HTMLImageElement | null;
        if (galleryImg) {
          openLightbox(galleryImg);
          return;
        }

        // Lightbox: navigazione e chiusura
        if (target.closest('#lightbox-close') || target.id === 'portfolio-lightbox') {
          closeLightbox();
          return;
        }
        if (target.closest('#lightbox-prev')) {
          renderLightboxImage(lightboxIndex - 1);
          return;
        }
        if (target.closest('#lightbox-next')) {
          renderLightboxImage(lightboxIndex + 1);
          return;
        }

        // Apre/chiude il menu mobile
        if (target.closest('#mobile-menu-toggle')) {
          const toggleBtn = document.getElementById('mobile-menu-toggle')!;
          const isOpen = toggleBtn.classList.toggle('open');
          document.getElementById('mobile-menu-overlay')?.classList.toggle('open', isOpen);
          document.body.classList.toggle('menu-open', isOpen);
          return;
        }

        // Chiude il menu quando si clicca su un collegamento interno dell'overlay
        if (target.closest('#mobile-menu-overlay a')) {
          closeMenu();
          return;
        }

        // Cambio tema chiaro/scuro
        if (target.closest('#theme-toggle')) {
          const isDark = document.documentElement.classList.contains('dark');
          document.documentElement.classList.toggle('dark', !isDark);
          localStorage.setItem('theme', isDark ? 'light' : 'dark');
        }
      });

      // Swipe su mobile per il Lightbox
      document.addEventListener('touchstart', (e) => {
        const overlay = document.getElementById('portfolio-lightbox');
        if (!overlay?.classList.contains('open')) return;
        touchStartX = e.changedTouches[0]?.clientX ?? 0;
      }, { passive: true });

      document.addEventListener('touchend', (e) => {
        const overlay = document.getElementById('portfolio-lightbox');
        if (!overlay?.classList.contains('open')) return;
        const touchEndX = e.changedTouches[0]?.clientX ?? 0;
        const delta = touchEndX - touchStartX;
        if (Math.abs(delta) > 45) {
          renderLightboxImage(delta > 0 ? lightboxIndex - 1 : lightboxIndex + 1);
        }
      }, { passive: true });

      // Tastiera: chiude menu/lightbox e naviga con frecce nel lightbox
      document.addEventListener('keydown', (e) => {
        const lightbox = document.getElementById('portfolio-lightbox');
        if (lightbox?.classList.contains('open')) {
          if (e.key === 'Escape') closeLightbox();
          else if (e.key === 'ArrowLeft') renderLightboxImage(lightboxIndex - 1);
          else if (e.key === 'ArrowRight') renderLightboxImage(lightboxIndex + 1);
          return;
        }
        if (e.key === 'Escape') closeMenu();
      });

      initScrollReveal();
      document.addEventListener('astro:page-load', initScrollReveal);
      document.addEventListener('astro:after-swap', () => {
        if (typeof (window as unknown as { applyTheme?: () => void }).applyTheme === 'function') {
          (window as unknown as { applyTheme: () => void }).applyTheme();
        }
        initScrollReveal();
      });
    </script>
  </body>
</html>
