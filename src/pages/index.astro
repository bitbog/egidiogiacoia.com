---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import { progettiBrandTurismo } from '../data/progetti-brand-turismo';
import {
  siteConfig,
  getWhatsAppChatUrl,
  getInstagramUrl
} from '../data/site';

const diaryEntries = await getCollection('diario');
const latestPosts = diaryEntries
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const nowEntry = await getEntry('now', 'index');
const nowLastUpdated = nowEntry?.data.lastUpdated;

function extractNowHighlights(markdownBody: string, limit = 3): { label: string; value: string }[] {
  if (!markdownBody) return [];
  const sections = markdownBody.split(/^##\s+/m).slice(1);
  const highlights: { label: string; value: string }[] = [];

  for (const section of sections) {
    if (highlights.length >= limit) break;
    const lines = section.split('\n').map((l) => l.trim());
    const heading = lines[0]?.replace(/\*+/g, '').trim();
    if (!heading) continue;

    const firstContentLine = lines
      .slice(1)
      .find((line) => line.length > 0 && !line.startsWith('#') && !line.startsWith('---'));

    if (!firstContentLine) continue;

    const cleanValue = firstContentLine
      .replace(/^[-+*]\s+/, '')
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/[*_`]+/g, '')
      .trim();

    if (cleanValue) {
      highlights.push({ label: heading, value: cleanValue });
    }
  }

  return highlights;
}

const nowHighlights = extractNowHighlights(nowEntry?.body || '', 3);
const fallbackNowHighlights = [
  { label: 'Focus attuale', value: 'Siti web locali, fotografia in Basilicata e nuovi prototipi in stampa 3D.' }
];
const displayedNowHighlights = nowHighlights.length > 0 ? nowHighlights : fallbackNowHighlights;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('it-IT', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  });
};

const baseUrl = import.meta.env.BASE_URL;
const whatsappChatUrl = getWhatsAppChatUrl();
const instagramUrl = getInstagramUrl();

const featuredCases = progettiBrandTurismo.map((p) => ({
  name: p.titoloBreve || p.titolo,
  tags: p.sitoWeb
    ? `Sito Web (${p.sitoWeb.dominio}) · Rebrand`
    : p.grafiche?.length
      ? 'Fotografia · Grafica'
      : p.fotoLabel || 'Fotografia'
}));

const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteConfig.siteUrl}/#person`,
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
      image: `${siteConfig.siteUrl}/img/portfolio/profilo.webp`,
      jobTitle: 'Fotografo, Sviluppatore Web e Progettista 3D',
      sameAs: [siteConfig.instagramUrl],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Potenza',
        addressRegion: 'Basilicata',
        addressCountry: 'IT'
      }
    },
    {
      '@type': ['ProfessionalService', 'Photographer'],
      '@id': `${siteConfig.siteUrl}/#service`,
      name: 'Egidio Giacoia — Fotografia, Sviluppo Web & Stampa 3D in Basilicata',
      url: siteConfig.siteUrl,
      provider: { '@id': `${siteConfig.siteUrl}/#person` },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Basilicata'
      },
      serviceType: [
        'Fotografia Commerciale, Social, Eventi e Ritratti',
        'Sviluppo Siti Web Veloci e SEO Locale',
        'Progettazione CAD e Stampa 3D'
      ]
    }
  ]
};
---

<BaseLayout
  title="Egidio Giacoia | Fotografia, Sviluppo Web, Stampa 3D & Blog in Basilicata"
  description="Portfolio, blog e progetti di Egidio Giacoia a Potenza e in Basilicata: fotografia commerciale e social, sviluppo siti web su misura, progettazione e stampa 3D."
  keywords="Egidio Giacoia, fotografo Basilicata, sviluppo siti web, stampa 3D, portfolio fotografo, blog Basilicata"
  schema={homeSchema}
>
  <!-- ===================== HERO UNIFICATA ===================== -->
  <section class="home-hero" id="top">
    <div class="home-hero-main">
      <p class="eyebrow">Potenza &amp; Basilicata · Fotografia, Sviluppo Web &amp; Stampa 3D</p>
      <h1>Immagini, siti web e stampa 3D con un <em>obiettivo</em>.</h1>
      <p class="lede">
        Sono <strong>Egidio Giacoia</strong>, studente di Informatica, fotografo e progettista 3D in Basilicata.
        Aiuto strutture ricettive, brand e persone a raccontarsi online e nel mondo fisico, coltivando allo stesso
        tempo questo spazio indipendente tra blog, progetti e vita quotidiana.
      </p>
      <div class="hero-actions">
        <a href={`${baseUrl}portfolio`} class="hero-btn-primary">Esplora il Portfolio &rarr;</a>
        <a href={`${baseUrl}contatti`} class="hero-btn-secondary">Contattami</a>
        {whatsappChatUrl && (
          <a href={whatsappChatUrl} target="_blank" rel="noopener noreferrer" class="hero-btn-ghost">
            Scrivimi su WhatsApp &#8599;
          </a>
        )}
      </div>
    </div>

    <aside class="home-identity-card reveal-on-scroll" aria-label="Profilo e ambiti di lavoro">
      <div class="identity-top">
        <img
          src="/img/portfolio/profilo.webp"
          alt="Egidio Giacoia"
          width="427"
          height="640"
          class="identity-avatar"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div>
          <span class="identity-kicker">Un unico referente</span>
          <h2>Egidio Giacoia</h2>
          <p class="identity-role">Fotografia · Web &amp; SEO · Stampa 3D</p>
        </div>
      </div>

      <ul class="identity-pillars">
        <li>
          <span class="pillar-idx">01</span>
          <span>Fotografia Commerciale, Social, Eventi &amp; Ritratti</span>
        </li>
        <li>
          <span class="pillar-idx">02</span>
          <span>Sviluppo Siti Web veloci &amp; SEO Locale</span>
        </li>
        <li>
          <span class="pillar-idx">03</span>
          <span>Progettazione CAD &amp; Stampa 3D su misura</span>
        </li>
      </ul>

      <div class="identity-footer">
        <span class="identity-location">{siteConfig.location}</span>
        <a href={`${baseUrl}chi-sono`} class="identity-more">Chi sono &rarr;</a>
      </div>
    </aside>
  </section>

  <!-- ===================== 01 · PORTFOLIO & LAVORI ===================== -->
  <section class="home-section" aria-labelledby="home-portfolio-title">
    <div class="section-head reveal-on-scroll">
      <div>
        <div class="kicker"><span class="num">01</span><span class="lab">Portfolio &amp; Servizi</span></div>
        <h2 id="home-portfolio-title">Progetti realizzati e aree di lavoro</h2>
      </div>
      <a href={`${baseUrl}portfolio`} class="section-all-link">Panoramica completa &rarr;</a>
    </div>

    <div class="home-bento">
      <!-- Hero Card: Brand, Turismo & Web -->
      <a href={`${baseUrl}portfolio/brand-turismo`} class="bento-card bento-hero brand-turismo-card reveal-on-scroll">
        <div class="card-bg-overlay hero-overlay"></div>
        <div class="bento-hero-grid">
          <div class="bento-hero-left">
            <span class="hero-badge">Area Principale · Basilicata</span>
            <h3>Brand, Turismo &amp; Sviluppo Web</h3>
            <p>
              Shooting fotografici commerciali e social, siti web veloci su misura e integrazioni in stampa 3D
              per destinazioni, B&amp;B e attività locali.
            </p>
            <ul class="service-pills" aria-label="Servizi inclusi">
              <li>Fotografia &amp; Social</li>
              <li>Siti Web &amp; SEO</li>
              <li>Rebrand &amp; Grafica</li>
              <li>Stampa 3D</li>
            </ul>
          </div>

          <div class="bento-hero-right">
            <span class="cases-label">Ultimi casi studio</span>
            <ul class="cases-list">
              {featuredCases.map((c) => (
                <li>
                  <strong>{c.name}</strong>
                  <span>{c.tags}</span>
                </li>
              ))}
            </ul>
            <span class="cases-cta">Apri i casi studio &rarr;</span>
          </div>
        </div>
      </a>

      <!-- 3 Card Sotto-sezioni -->
      <a href={`${baseUrl}portfolio/stampa-3d`} class="bento-card bento-sub stampa-3d-card reveal-on-scroll" style="--reveal-delay: 60ms;">
        <div class="card-bg-overlay stampa-3d-overlay"></div>
        <div class="bento-sub-inner">
          <span class="sub-kicker">02 · Manifattura Additiva</span>
          <h3>Progettazione &amp; Stampa 3D</h3>
          <p>Rilievi 3D, scansioni del volto, portachiavi NFC, lampade d'arredo e prototipi CAD.</p>
          <span class="sub-more">Scopri il 3D &rarr;</span>
        </div>
      </a>

      <a href={`${baseUrl}portfolio/eventi`} class="bento-card bento-sub eventi-card reveal-on-scroll" style="--reveal-delay: 110ms;">
        <div class="card-bg-overlay"></div>
        <div class="bento-sub-inner">
          <span class="sub-kicker">03 · Reportage</span>
          <h3>Fotografia Eventi</h3>
          <p>Concerti, live, festival e feste private raccontati con discrezione.</p>
          <span class="sub-more">Vedi i reportage &rarr;</span>
        </div>
      </a>

      <a href={`${baseUrl}portfolio/ritratti`} class="bento-card bento-sub ritratti-card reveal-on-scroll" style="--reveal-delay: 160ms;">
        <div class="card-bg-overlay"></div>
        <div class="bento-sub-inner">
          <span class="sub-kicker">04 · Persone</span>
          <h3>Fotografia Ritrattistica</h3>
          <p>Ritratti professionali e creativi in studio o all'aperto in Basilicata.</p>
          <span class="sub-more">Vedi i ritratti &rarr;</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===================== 02 · BLOG & NOW ===================== -->
  <section class="home-section" aria-labelledby="home-space-title">
    <div class="section-head reveal-on-scroll">
      <div>
        <div class="kicker"><span class="num">02</span><span class="lab">Il Mio Spazio sul Web</span></div>
        <h2 id="home-space-title">Blog &amp; Day in the life</h2>
      </div>
      <a href={`${baseUrl}blog`} class="section-all-link">Tutti gli articoli &rarr;</a>
    </div>

    <div class="space-grid">
      <!-- Sinistra: Ultimi 3 articoli del Blog -->
      <div class="blog-panel reveal-on-scroll">
        <div class="panel-head">
          <span class="panel-kicker">Ultimi dal Blog</span>
          <a href={`${baseUrl}blog`} class="panel-link">Archivio &rarr;</a>
        </div>

        <div class="home-posts-list">
          {latestPosts.map((post) => (
            <a href={`${baseUrl}blog/${post.id}`} class="home-post-item">
              <div class="home-post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                {post.data.category && <span class="home-post-cat">{post.data.category}</span>}
              </div>
              <h3>{post.data.title}</h3>
              {post.data.description && <p>{post.data.description}</p>}
            </a>
          ))}
        </div>
      </div>

      <!-- Destra: Anteprima dinamica pagina Now -->
      <aside class="now-panel reveal-on-scroll" style="--reveal-delay: 90ms;" aria-label="Cosa sto facendo ora">
        <div class="panel-head">
          <span class="panel-kicker">Now · Day in the life</span>
          {nowLastUpdated && (
            <span class="now-updated">Agg. {formatDate(nowLastUpdated)}</span>
          )}
        </div>

        <h3>Cosa sto facendo in questo periodo</h3>

        <ul class="now-highlights">
          {displayedNowHighlights.map((item) => (
            <li>
              <span class="now-hl-label">{item.label}</span>
              <span class="now-hl-value">{item.value}</span>
            </li>
          ))}
        </ul>

        <a href={`${baseUrl}now`} class="now-open-btn">Apri la pagina Now &rarr;</a>
      </aside>
    </div>
  </section>

  <!-- ===================== 03 · CONTATTI & SOCIAL ===================== -->
  <section class="home-section home-contacts-section" aria-labelledby="home-contacts-title">
    <div class="section-head reveal-on-scroll">
      <div>
        <div class="kicker"><span class="num">03</span><span class="lab">Contatti &amp; Social</span></div>
        <h2 id="home-contacts-title">Parliamo del tuo progetto</h2>
      </div>
      <a href={`${baseUrl}contatti`} class="section-all-link">Pagina contatti &rarr;</a>
    </div>

    <div class="home-contact-grid reveal-on-scroll">
      <!-- Instagram -->
      <article class="hc-card is-primary">
        <div class="hc-head-row">
          <span class="hc-label">Instagram</span>
          <span class={`hc-pill ${instagramUrl ? 'is-on' : ''}`}>
            {instagramUrl ? 'Attivo' : 'In arrivo'}
          </span>
        </div>
        {siteConfig.instagramHandle && <p class="hc-value">{siteConfig.instagramHandle}</p>}
        <p class="hc-desc">
          Scrivimi in DM su Instagram per progetti, preventivi, collaborazioni o per seguire i nuovi lavori.
        </p>
        <div class="hc-actions">
          {instagramUrl ? (
            <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="hc-btn-primary">
              Scrivimi su Instagram &#8599;
            </a>
          ) : (
            <span class="hc-disabled" aria-disabled="true">Profilo in arrivo</span>
          )}
        </div>
      </article>

      <!-- WhatsApp -->
      <article class="hc-card">
        <div class="hc-head-row">
          <span class="hc-label">WhatsApp</span>
          <span class={`hc-pill ${whatsappChatUrl ? 'is-on' : ''}`}>
            {whatsappChatUrl ? 'Attivo' : 'In arrivo'}
          </span>
        </div>
        <p class="hc-desc">Chat veloce per preventivi o disponibilità.</p>
        <div class="hc-actions">
          {whatsappChatUrl ? (
            <a href={whatsappChatUrl} target="_blank" rel="noopener noreferrer" class="hc-btn-primary">
              Apri WhatsApp &#8599;
            </a>
          ) : (
            <span class="hc-disabled" aria-disabled="true">Numero diretto in arrivo</span>
          )}
        </div>
      </article>
    </div>

    <p class="channel-note reveal-on-scroll">
      Vuoi ricevere solo gli aggiornamenti quando esce un nuovo articolo sul blog?
      <a href={siteConfig.whatsappChannelUrl} target="_blank" rel="noopener noreferrer">Unisciti al Canale WhatsApp &#8599;</a>
    </p>
  </section>
</BaseLayout>

<style>
  section {
    border-top: none;
    padding: 0;
  }

  /* ---------- HERO UNIFICATA ---------- */
  .home-hero {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: var(--s7);
    align-items: center;
    padding-top: var(--s2);
    padding-bottom: var(--s7);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--s4);
  }

  .home-hero-main h1 {
    font-size: clamp(34px, 5vw, 54px);
    max-width: 15ch;
    margin-bottom: var(--s4);
  }

  .lede {
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 58ch;
    margin-bottom: var(--s5);
    line-height: 1.65;
  }

  .lede strong {
    color: var(--text);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .hero-btn-primary,
  .hero-btn-secondary,
  .hero-btn-ghost {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 10px;
    white-space: nowrap;
    transition: transform var(--transition-fast), opacity var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
  }

  .hero-btn-primary {
    background: var(--accent);
    color: var(--paper);
  }

  .hero-btn-primary:hover {
    opacity: 0.92;
    transform: translateY(-1.5px);
    color: var(--paper);
  }

  .hero-btn-secondary {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .hero-btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-2);
  }

  .hero-btn-ghost {
    background: var(--accent-2);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
  }

  .hero-btn-ghost:hover {
    background: var(--accent);
    color: var(--paper);
  }

  /* Identity Card a destra */
  .home-identity-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    box-shadow: 0 16px 38px -20px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .identity-top {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .identity-avatar {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 2px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    flex-shrink: 0;
  }

  .identity-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 2px;
  }

  .identity-top h2 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin: 0 0 2px;
    line-height: 1.15;
  }

  .identity-role {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    margin: 0;
  }

  .identity-pillars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .identity-pillars li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
    color: var(--text);
  }

  .pillar-idx {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent);
    flex-shrink: 0;
  }

  .identity-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 4px;
  }

  .identity-location {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent);
    background: var(--accent-2);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 999px;
    padding: 4px 11px;
  }

  .identity-more {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .identity-more:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ---------- SEZIONI ---------- */
  .home-section {
    border-top: 1px solid var(--border);
    padding: var(--s7) 0;
  }

  .home-contacts-section {
    padding-bottom: var(--s4);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--s4);
    flex-wrap: wrap;
    margin-bottom: var(--s5);
  }

  .section-head h2 {
    margin: 0;
  }

  .section-all-link {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    padding-bottom: 2px;
    white-space: nowrap;
  }

  .section-all-link:hover {
    border-color: var(--accent);
  }

  /* ---------- PORTFOLIO BENTO ---------- */
  .home-bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s4);
  }

  .bento-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    text-decoration: none;
    color: #ffffff;
    position: relative;
    overflow: hidden;
    display: flex;
    z-index: 1;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-color: var(--surface);
    z-index: -2;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .brand-turismo-card::before {
    background-image: url('/img/portfolio/bg-brand-turismo.webp');
  }

  .stampa-3d-card::before {
    background-image: url('/img/portfolio/bg-stampa-3d.webp');
    background-position: center 45%;
  }

  .eventi-card::before {
    background-image: url('/img/portfolio/bg-eventi.webp');
  }

  .ritratti-card::before {
    background-image: url('/img/portfolio/bg-ritratti.webp');
  }

  .card-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(14, 18, 22, 0.3), rgba(14, 18, 22, 0.82));
    z-index: -1;
  }

  .stampa-3d-overlay {
    background: linear-gradient(to bottom, rgba(14, 18, 22, 0.28), rgba(14, 18, 22, 0.86));
  }

  .hero-overlay {
    background: linear-gradient(125deg, rgba(11, 23, 25, 0.84) 0%, rgba(16, 22, 24, 0.58) 55%, rgba(12, 18, 20, 0.84) 100%);
  }

  .bento-card:hover {
    border-color: var(--accent);
    box-shadow: 0 18px 40px -16px color-mix(in srgb, var(--accent) 34%, transparent);
    transform: translateY(-2px);
    color: #ffffff;
  }

  .bento-hero:hover::before,
  .stampa-3d-card:hover::before,
  .eventi-card:hover::before,
  .ritratti-card:hover::before {
    transform: scale(1.045);
  }

  .bento-hero {
    grid-column: 1 / -1;
    min-height: 270px;
    padding: var(--s6);
    align-items: stretch;
  }

  .bento-hero-grid {
    width: 100%;
    display: grid;
