---
// Importa lo stile globale del sito
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Immagine per le anteprime social (percorso relativo alla root del sito) */
  ogImage?: string;
}

// Estrae le props con valori predefiniti di fallback
const {
  title = "Egidio Giacoia",
  description = "Sito personale, blog e portfolio di Egidio Giacoia.",
  ogImage = "/img/portfolio/profilo.webp"
} = Astro.props;

// URL canonico e URL assoluto dell'immagine social, costruiti dal dominio configurato in astro.config.mjs
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
// Aggiunge uno slash finale per standardizzare il confronto dei percorsi
const cleanPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

// Helper per determinare se un collegamento del menu è attivo (pagina corrente)
const isActive = (path: string) => {
  const target = `${baseUrl}${path}`.replace(/\/+/g, '/');
  const targetWithSlash = target.endsWith('/') ? target : `${target}/`;
  
  if (path === '' || path === '/') {
    return cleanPath === targetWithSlash;
  }
  return cleanPath.startsWith(targetWithSlash);
};

// Controlla se ci troviamo nella Home Page (usato per nascondere i contatti nel footer)
const isHome = isActive('/') || isActive('');
---

<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- SEO & Favicon -->
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F2F2EF" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15161B" />

    <!-- Open Graph / Anteprime social (WhatsApp, Telegram, ecc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Egidio Giacoia" />
    <meta name="twitter:card" content="summary" />

    <!-- Font di Google: preconnect + link (non blocca il primo rendering come faceva @import nel CSS) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=DM+Mono:wght@400;500&display=swap" />
    
    <!-- Script Tema Automatico (Inline per prevenire lo sfarfallio della pagina all'avvio) -->
    <script is:inline>
      // Funzione globale che applica il tema in base a localStorage o preferenze di sistema
      window.applyTheme = function() {
        const storedTheme = localStorage.getItem('theme');
        let isDark = false;
        
        if (storedTheme) {
          isDark = storedTheme === 'dark';
        } else {
          isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        
        document.documentElement.classList.toggle('dark', isDark);
      };
      
      // Esegue all'avvio
      window.applyTheme();
      
      // Resta in ascolto di eventuali cambi di tema nelle impostazioni di sistema del dispositivo
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        // Se l'utente non ha impostato un tema manuale, segue il sistema
        if (!localStorage.getItem('theme')) {
          document.documentElement.classList.toggle('dark', e.matches);
        }
      });
    </script>
  </head>
  <body>
    <!-- Barra dell'Header Fissa (Sticky Top) -->
    <header class="bar">
      <div class="bar-in">
        <!-- Logo / Nome Brand -->
        <a href={baseUrl} class="brand">Egidio Giacoia</a>
        
        <!-- Collegamenti Desktop (Nascosti su Mobile) -->
        <nav class="links">
          <a href={`${baseUrl}diario`} class={isActive('diario') ? 'active' : ''} id="nav-diario">Diario</a>
          <a href={`${baseUrl}portfolio`} class={isActive('portfolio') ? 'active' : ''} id="nav-portfolio">Portfolio</a>
          <a href={`${baseUrl}now`} class={isActive('now') ? 'active' : ''} id="nav-now">Now</a>
        </nav>

        <!-- Pulsante Cambio Tema (Visibile sia su Desktop che Mobile) -->
        <button id="theme-toggle" class="theme-toggle-btn" aria-label="Cambia tema scuro/chiaro">
          <!-- Icona Sole (mostrata in dark mode) -->
          <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <!-- Icona Luna (mostrata in light mode) -->
          <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </div>
    </header>

    <!-- Pulsante Menu Flottante per Mobile (Cerchio in basso a destra) -->
    <button id="mobile-menu-toggle" class="mobile-menu-toggle-btn" aria-label="Menu navigazione">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <!-- Schermata Overlay del Menu Mobile (Sfocatura a schermo intero) -->
    <div id="mobile-menu-overlay" class="mobile-menu-overlay">
      <nav class="mobile-nav">
        <a href={`${baseUrl}diario`} class={isActive('diario') ? 'active' : ''}>Diario</a>
        <a href={`${baseUrl}portfolio`} class={isActive('portfolio') ? 'active' : ''}>Portfolio</a>
        <a href={`${baseUrl}now`} class={isActive('now') ? 'active' : ''}>Now</a>
      </nav>
    </div>

    <!-- Contenitore Principale del Contenuto -->
    <main class="wrap">
      <div class="container">
        <!-- Slot per inserire il codice specifico di ogni pagina -->
        <slot />
      </div>

      <!-- Piè di pagina (Footer) -->
      <footer>
        <!-- Se non ci troviamo in Home Page, visualizziamo i contatti in colonna -->
        {!isHome && (
          <div class="footer-contacts">
            <p>
              Resta aggiornato: <a href="https://whatsapp.com/channel/0029VaFJXAvJ93wY6tcBGr2w" target="_blank" rel="noopener noreferrer">Canale WhatsApp</a>
              &nbsp;·&nbsp;
              Scrivimi: <a href="mailto:scrivimiegidio@gmail.com?subject=Messaggio%20dal%20sito">E-mail</a>
            </p>
          </div>
        )}
        <!-- Firma di Copyright -->
        <p>© 2026 Egidio Giacoia</p>
      </footer>
    </main>

    <!-- Script per la gestione del Menu Mobile e del Theme Toggle.
         Usa la delega degli eventi sul documento: i listener vengono registrati una sola volta
         e funzionano anche se il DOM viene sostituito (es. Astro View Transitions). -->
    <script>
      function closeMenu() {
        document.getElementById('mobile-menu-toggle')?.classList.remove('open');
        document.getElementById('mobile-menu-overlay')?.classList.remove('open');
        document.body.classList.remove('menu-open');
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;

        // Apre/chiude il menu mobile
        if (target.closest('#mobile-menu-toggle')) {
          const toggleBtn = document.getElementById('mobile-menu-toggle')!;
          const isOpen = toggleBtn.classList.toggle('open');
          document.getElementById('mobile-menu-overlay')?.classList.toggle('open', isOpen);
          document.body.classList.toggle('menu-open', isOpen); // Previene lo scroll della pagina
          return;
        }

        // Chiude il menu quando si clicca su un collegamento interno dell'overlay
        if (target.closest('#mobile-menu-overlay a')) {
          closeMenu();
          return;
        }

        // Cambio tema chiaro/scuro
        if (target.closest('#theme-toggle')) {
          const isDark = document.documentElement.classList.contains('dark');
          document.documentElement.classList.toggle('dark', !isDark);
          localStorage.setItem('theme', isDark ? 'light' : 'dark');
        }
      });

      // Chiude il menu premendo il tasto ESC della tastiera
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      // Ri-applica il tema corretto dopo uno swap di pagina con Astro View Transitions
      document.addEventListener('astro:after-swap', () => {
        if (typeof window.applyTheme === 'function') {
          window.applyTheme();
        }
      });
    </script>
  </body>
</html>
